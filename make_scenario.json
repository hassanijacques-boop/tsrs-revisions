{
  "name": "Pr7 - Nouveau code client",
  "flow": [
    {
      "id": 1,
      "module": "webhook:customWebhook",
      "name": "Webhook Systeme.io",
      "params": {
        "url": "https://hook.eu1.make.com/ra1edfdpucf61ad6342nif89gqkje2hf"
      }
    },
    {
      "id": 2,
      "module": "http:makeARequest",
      "name": "Lire codes.json actuel",
      "params": {
        "url": "https://api.github.com/repos/hassanijacques-boop/protocole7j/contents/codes.json",
        "method": "GET",
        "headers": {
          "Authorization": "token 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",
          "Accept": "application/vnd.github.v3+json"
        }
      }
    },
    {
      "id": 3,
      "module": "tools:base64Decode",
      "name": "Decoder le JSON",
      "params": {
        "data": "{{2.data.content}}"
      }
    },
    {
      "id": 4,
      "module": "tools:jsonParse",
      "name": "Parser le JSON",
      "params": {
        "data": "{{3.data}}"
      }
    },
    {
      "id": 5,
      "module": "tools:addItemToArray",
      "name": "Ajouter le nouveau code",
      "params": {
        "array": "{{4.data.codes}}",
        "value": "P30J-{%= Math.random().toString(36).substring(2,8).toUpperCase() %}"
      }
    },
    {
      "id": 6,
      "module": "tools:jsonParse",
      "name": "Re-encoder en JSON",
      "params": {
        "data": "{\"codes\": {{5.newArray}} }"
      }
    },
    {
      "id": 7,
      "module": "tools:base64Encode",
      "name": "Encoder en base64",
      "params": {
        "data": "{{6.data}}"
      }
    },
    {
      "id": 8,
      "module": "http:makeARequest",
      "name": "Mettre a jour codes.json",
      "params": {
        "url": "https://api.github.com/repos/hassanijacques-boop/protocole7j/contents/codes.json",
        "method": "PUT",
        "headers": {
          "Authorization": "token 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",
          "Content-Type": "application/json"
        },
        "body": {
          "message": "Ajout nouveau code client via Make",
          "content": "{{7.data}}",
          "sha": "{{2.data.sha}}"
        }
      }
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "roundtrips": false,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true
    }
  }
}